<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mmr_pkg</name>
  <version>0.1.0</version>
  <description>
    URDF/xacro description of mmr_bot: a three-wheeled kiwi-drive holonomic
    mobile base carrying an SO-101 arm, a Raspberry Pi 5 and an RPLIDAR C1.
    Geometry is derived from the Fusion 360 STEP export; the arm is vendored
    from TheRobotStudio/SO-ARM100.
  </description>

  <maintainer email="TODO@todo.invalid">steve</maintainer>

  <!-- TODO confirm: package licence. The vendored SO-101 meshes and URDF are
       Apache-2.0 from TheRobotStudio/SO-ARM100; see meshes/arm/LICENSE-NOTICE. -->
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
