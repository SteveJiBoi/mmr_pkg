<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mmr_pkg</name>
  <version>0.1.0</version>
  <description>
    URDF/xacro description of mmr_bot: a three-wheeled kiwi-drive holonomic
    mobile base carrying an SO-101 arm, a Raspberry Pi 5 and an RPLIDAR C1.
    Geometry is derived from the Fusion 360 STEP export; the arm is vendored
    from TheRobotStudio/SO-ARM100.
  </description>

  <maintainer email="TODO@todo.invalid">steve</maintainer>

  <!-- TODO confirm: package licence. The vendored SO-101 meshes and URDF are
       Apache-2.0 from TheRobotStudio/SO-ARM100; see meshes/arm/LICENSE-NOTICE. -->
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- Phase 1: description + RViz -->
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Phase 2: kiwi_drive_node -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <!-- esp32_bridge answers "is the link alive, and how bad is it?" on
       /diagnostics rather than by printing. diagnostic_msgs is part of
       common_interfaces, so this is not a new thing to install. -->
  <exec_depend>diagnostic_msgs</exec_depend>
  <!-- numpy is used only by forward_kinematics (pseudo-inverse) and is
       imported lazily; the inverse_kinematics path that the node runs every
       cycle is pure Python. Declared anyway because odometry calls FK. -->
  <exec_depend>python3-numpy</exec_depend>

  <!-- Phase 2: ros2_control. The three controller packages are named
       individually rather than depending on the ros2_controllers metapackage,
       so the dependency list states exactly which plugins this package's
       config/controllers.yaml actually loads. -->
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>velocity_controllers</exec_depend>
  <exec_depend>position_controllers</exec_depend>

  <!-- Phase 2: Gazebo Harmonic. Only needed to simulate; the description and
       kiwi_drive_node work on real hardware without these installed. -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>

  <!-- Phase 3: real hardware (launch/robot.launch.py, launch/teleop.launch.py).
       The drive path is UDP straight to the ESP32 and needs nothing but the
       Python standard library, so esp32_bridge and kb_teleop add no dependency
       of their own.

       sllidar_ros2 is DELIBERATELY NOT LISTED. It is a from-source checkout in
       the same workspace (Slamtec/sllidar_ros2), not a key in the ROS index, so
       naming it here makes `rosdep install` fail to resolve it and abort before
       it installs anything else.

       Nothing is lost by omitting it. An exec_depend would only buy colcon
       build ordering, and there is no ordering requirement: mmr_pkg is Python
       and data, it never compiles or links against the driver. robot.launch.py
       reaches it at LAUNCH time through FindPackageShare, which fails loudly
       and specifically if the driver is not built. Check out and build
       sllidar_ros2 alongside this package; see README "Phase 3".

       The C1 needs that driver specifically; the older rplidar_ros does not
       support it.

       v4l2_camera and teleop_twist_keyboard ARE real rosdep keys
       (ros-jazzy-*), so they stay. teleop_twist_keyboard is not launched by
       anything here; it is kept as a second, independent /cmd_vel source for
       answering "is it my keyboard node or the bridge?". -->
  <exec_depend>v4l2_camera</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
