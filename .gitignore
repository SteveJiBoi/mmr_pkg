__pycache__/
*.py[cod]
.pytest_cache/

# colcon, if you ever build in-tree
/build/
/install/
/log/

# The expanded URDF used to live in build/. It was renamed to generated/
# because "build" is the exact directory name colcon creates, and a package
# whose source tree contains one invites
#   failed to create symbolic link ... existing path cannot be removed
# on the next --symlink-install. Nothing generated by a build tool belongs in
# here; generated/ holds one committed artifact, on purpose, explained below.

# NOTE: generated/robot.urdf is deliberately NOT ignored. It is the expanded
# description that tools/check_urdf_lite.py, tools/check_phase2.py and
# test_kiwi_kinematics.py all read, and having it in the tree means a reviewer
# can see the actual URDF without needing xacro. Regenerate with:
#   python tools/xacro_lite.py urdf/mmr_bot.urdf.xacro -o generated/robot.urdf
