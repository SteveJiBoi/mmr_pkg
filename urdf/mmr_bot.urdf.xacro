<?xml version="1.0"?>
<!-- ====================================================================== -->
<!-- mmr_bot - top-level description                                        -->
<!--                                                                        -->
<!--   base_footprint                                                       -->
<!--    +- base_link                        (chassis, camera and Pi merged)  -->
<!--        +- wheel_0_link                 continuous,  60 deg              -->
<!--        +- wheel_1_link                 continuous, 180 deg              -->
<!--        +- wheel_2_link                 continuous, 300 deg              -->
<!--        +- laser_frame                  fixed, RPLIDAR C1                -->
<!--        +- arm_base_link                fixed, SO-101 mount              -->
<!--            +- arm_shoulder_link        shoulder_pan                     -->
<!--                +- arm_upper_arm_link   shoulder_lift                    -->
<!--                    +- arm_lower_arm_link   elbow_flex                   -->
<!--                        +- arm_wrist_link   wrist_flex                   -->
<!--                            +- arm_gripper_link         wrist_roll       -->
<!--                                +- arm_moving_jaw_..._link  gripper      -->
<!--                                +- arm_gripper_frame_link   fixed        -->
<!--                                                                        -->
<!-- 14 links, 13 joints, of which 9 are movable (3 wheels + 6 arm).         -->
<!-- ====================================================================== -->
<!-- xmlns:gz is required by the omniwheel friction block in gazebo.xacro,
     which uses gz:expressed_in on <fdir1> to pin the roller axis to the
     chassis frame instead of the (spinning) wheel frame. Declared here at the
     root because that is the only place a namespace declaration survives
     xacro expansion into the final URDF. -->
<robot name="mmr_bot"
       xmlns:xacro="http://www.ros.org/wiki/xacro"
       xmlns:gz="http://gazebosim.org/schema">

  <!-- ==================================================================== -->
  <!-- Phase 2 toggles.                                                     -->
  <!--                                                                      -->
  <!--   ros2 run xacro xacro mmr_bot.urdf.xacro                (sim, full)  -->
  <!--   ros2 run xacro xacro mmr_bot.urdf.xacro gazebo:=false  (Phase 1)    -->
  <!--                                                                      -->
  <!-- gazebo:=false reproduces the Phase 1 description byte-for-byte apart  -->
  <!-- from the xmlns:gz attribute, so display.launch.py and anything that   -->
  <!-- only wants geometry are unaffected by Phase 2.                        -->
  <!-- ==================================================================== -->
  <xacro:arg name="gazebo" default="true"/>

  <xacro:include filename="$(find mmr_pkg)/urdf/inertial_macros.xacro"/>
  <xacro:include filename="$(find mmr_pkg)/urdf/base.xacro"/>
  <xacro:include filename="$(find mmr_pkg)/urdf/sensors.xacro"/>
  <xacro:include filename="$(find mmr_pkg)/urdf/arm.xacro"/>

  <!-- ================================================================== -->
  <!-- SO-101 arm mount.                                                   -->
  <!--                                                                     -->
  <!-- Solved exactly, not eyeballed. The CAD part 'Base_SO101 v12:1' and   -->
  <!-- upstream 'base_so101_v2.stl' were shown to share an identical local  -->
  <!-- mesh frame (bbox agreement to 1e-16 m), so the arm's URDF base_link  -->
  <!-- is recovered as  T_arm = T_cad_world * inv(T_urdf_visual_origin).    -->
  <!-- Round-tripping the STL back through that transform reproduces the    -->
  <!-- CAD world bbox to within 0.5 mm. See tools/arm_mount.py.             -->
  <!--                                                                     -->
  <!-- rpy is exactly zero: the arm's forward axis already coincides with   -->
  <!-- the robot's, both facing CAD -Y.                                     -->
  <!-- ================================================================== -->
  <xacro:property name="arm_mount_x" value="0.014091"/>
  <xacro:property name="arm_mount_y" value="-0.000442"/>
  <xacro:property name="arm_mount_z" value="0.079200"/>

  <xacro:so101_arm prefix="arm_" parent="base_link">
    <origin xyz="${arm_mount_x} ${arm_mount_y} ${arm_mount_z}" rpy="0 0 0"/>
  </xacro:so101_arm>

  <!-- ================================================================== -->
  <!-- Phase 2: simulation.                                                -->
  <!--                                                                     -->
  <!-- Both files are included INSIDE the gazebo guard. ros2_control.xacro  -->
  <!-- is guarded too, not just gazebo.xacro, because its only hardware     -->
  <!-- plugin today is the Gazebo one - there is no ESP32                   -->
  <!-- hardware_interface yet (see the TODO in that file). When one is      -->
  <!-- written this include moves out of the guard and the `sim` parameter  -->
  <!-- of mmr_ros2_control starts earning its keep.                         -->
  <!-- ================================================================== -->
  <xacro:if value="$(arg gazebo)">
    <xacro:include filename="$(find mmr_pkg)/urdf/ros2_control.xacro"/>
    <xacro:include filename="$(find mmr_pkg)/urdf/gazebo.xacro"/>

    <xacro:mmr_ros2_control sim="true"/>
    <xacro:mmr_gazebo/>
  </xacro:if>

</robot>
