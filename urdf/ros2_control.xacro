<?xml version="1.0"?>
<!-- ====================================================================== -->
<!-- ros2_control interface description (Phase 2).                          -->
<!--                                                                        -->
<!-- Declares WHICH interfaces exist on each joint. It does NOT decide what  -->
<!-- drives them - that is config/controllers.yaml.                          -->
<!--                                                                        -->
<!-- Plugin strings here are not from memory. They were read from the        -->
<!-- upstream pluginlib export on the branch that matches Jazzy:             -->
<!--   gz_ros2_control/gz_hardware_plugins.xml  ->                           -->
<!--     name="gz_ros2_control/GazeboSimSystem"                              -->
<!-- The legacy alias ign_ros2_control/IgnitionSystem lives in the same file -->
<!-- and must NOT be used on Harmonic.                                       -->
<!-- ====================================================================== -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- sim=true  -> Gazebo Harmonic via gz_ros2_control
       sim=false -> a real hardware interface, which DOES NOT EXIST YET.
                    There is no ESP32 hardware_interface in this package; the
                    real robot is currently driven by kiwi_drive_node talking
                    to whatever your firmware exposes. Left as an explicit
                    branch so adding one later is obvious, rather than
                    pretending the sim plugin also drives hardware. -->
  <xacro:macro name="mmr_ros2_control" params="sim:=true">

    <ros2_control name="mmr_bot_system" type="system">

      <hardware>
        <xacro:if value="${sim}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
        <xacro:unless value="${sim}">
          <!-- TODO(hardware): no real hardware_interface is written yet.
               Expanding with sim:=false deliberately produces a URDF that
               ros2_control will reject at load time with a clear "plugin not
               found" error, rather than silently loading nothing. -->
          <plugin>mmr_pkg/NoHardwareInterfaceYet</plugin>
        </xacro:unless>
      </hardware>

      <!-- ================================================================ -->
      <!-- Wheels: VELOCITY commanded.                                       -->
      <!--                                                                   -->
      <!-- No <param name="min"/max"> here. The joints are `continuous` and   -->
      <!-- so carry no <limit> in the URDF, and no motor datasheet was        -->
      <!-- supplied, so any figure written here would be invented. Speed is   -->
      <!-- limited instead in kiwi_drive_node (max_wheel_speed), where it is  -->
      <!-- a documented, overridable ROS parameter rather than a magic number -->
      <!-- baked into the description.                                        -->
      <!-- ================================================================ -->
      <xacro:macro name="wheel_iface" params="name">
        <joint name="${name}">
          <command_interface name="velocity"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
      </xacro:macro>

      <xacro:wheel_iface name="wheel_0_joint"/>
      <xacro:wheel_iface name="wheel_1_joint"/>
      <xacro:wheel_iface name="wheel_2_joint"/>

      <!-- ================================================================ -->
      <!-- Arm: POSITION commanded.                                          -->
      <!--                                                                   -->
      <!-- A LeRobot policy emits joint positions, so position is the         -->
      <!-- interface that matches the trained action space. Joint names are   -->
      <!-- upstream's, unprefixed, exactly as in Phase 1 - a policy trained    -->
      <!-- on this action space would break if they changed.                  -->
      <!--                                                                    -->
      <!-- Limits are NOT repeated here. Each of these joints is `revolute`    -->
      <!-- and carries upstream's <limit> verbatim in arm.xacro;              -->
      <!-- ros2_control reads those. Duplicating them would create two        -->
      <!-- sources of truth that can silently drift.                          -->
      <!-- ================================================================ -->
      <xacro:macro name="arm_iface" params="name">
        <joint name="${name}">
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
      </xacro:macro>

      <xacro:arm_iface name="shoulder_pan"/>
      <xacro:arm_iface name="shoulder_lift"/>
      <xacro:arm_iface name="elbow_flex"/>
      <xacro:arm_iface name="wrist_flex"/>
      <xacro:arm_iface name="wrist_roll"/>
      <xacro:arm_iface name="gripper"/>

    </ros2_control>

  </xacro:macro>

</robot>
